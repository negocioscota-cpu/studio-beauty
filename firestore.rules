rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // FUNÇÕES AUXILIARES
    // ============================================================

    // Verifica se está autenticado
    function isAuth() {
      return request.auth != null;
    }

    // Verifica se é o próprio owner
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // Verifica se o usuário é profissional vinculado ao owner
    function isProfessionalOf(ownerId) {
      return isAuth() && exists(/databases/$(database)/documents/professionals/$(request.auth.uid))
        && get(/databases/$(database)/documents/professionals/$(request.auth.uid)).data.ownerId == ownerId
        && get(/databases/$(database)/documents/professionals/$(request.auth.uid)).data.status == 'active';
    }

    // Verifica se é owner OU profissional do studio
    function isTeamMember(ownerId) {
      return isOwner(ownerId) || isProfessionalOf(ownerId);
    }

    // Retorna o ownerId efetivo do usuário autenticado:
    // - Se é profissional → retorna o ownerId do vínculo
    // - Se é owner → retorna o próprio uid
    function effectiveOwnerId() {
      return exists(/databases/$(database)/documents/professionals/$(request.auth.uid))
        && get(/databases/$(database)/documents/professionals/$(request.auth.uid)).data.status == 'active'
        ? get(/databases/$(database)/documents/professionals/$(request.auth.uid)).data.ownerId
        : request.auth.uid;
    }

    // ============================================================
    // COMPANY — Perfil do studio (só owner)
    // ============================================================
    match /companies/{companyId} {
      // Owner sempre pode ler/escrever o próprio doc; profissionais podem ler
      allow read: if isOwner(companyId) || isProfessionalOf(companyId);
      allow write: if isOwner(companyId);

      // Subcoleção team — gerenciada pelo owner
      match /team/{memberId} {
        allow read: if isOwner(companyId) || isProfessionalOf(companyId);
        allow write: if isOwner(companyId);
      }

      // Subcoleção bolsa_beleza — planejamento financeiro (só owner)
      match /bolsa_beleza/{docId} {
        allow read, write: if isOwner(companyId);
      }
    }

    // ============================================================
    // PROFESSIONALS — Registro de profissionais
    // ============================================================
    match /professionals/{profId} {
      // Owner pode ler profissionais vinculados a ele; profissional lê o próprio
      allow read: if isAuth() && (
        request.auth.uid == profId ||
        resource.data.ownerId == request.auth.uid
      );
      // Criação: só o próprio usuário pode criar seu registro de profissional
      allow create: if isAuth() && request.auth.uid == profId;
      allow update: if isAuth() && (
        request.auth.uid == profId ||
        resource.data.ownerId == request.auth.uid
      );
      allow delete: if isAuth() && resource.data.ownerId == request.auth.uid;
    }

    // ============================================================
    // TEAM_INVITES — Convites de equipe
    // ============================================================
    match /team_invites/{inviteId} {
      // Leitura: owner dos convites ou destinatário
      allow read: if isAuth() && (
        resource == null ||
        resource.data.ownerId == request.auth.uid ||
        resource.data.email == request.auth.token.email
      );
      // Criação: owner deve ser quem está criando
      allow create: if isAuth() && request.resource.data.ownerId == request.auth.uid;
      // Atualização: owner ou destinatário (para aceitar/rejeitar)
      allow update: if isAuth() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.email == request.auth.token.email
      );
      allow delete: if isAuth() && resource.data.ownerId == request.auth.uid;
    }

    // ============================================================
    // DADOS COMPARTILHADOS DO STUDIO
    // Owner e profissionais vinculados podem ler/escrever
    // userId = ownerId do studio
    // ============================================================

    // CLIENTES — compartilhado com toda equipe
    match /clients/{docId} {
      allow read: if isAuth() && (
        resource == null || isTeamMember(resource.data.userId)
      );
      // Criação: userId deve ser o ownerId efetivo do criador
      allow create: if isAuth()
        && request.resource.data.userId == effectiveOwnerId();
      allow update, delete: if isAuth() && isTeamMember(resource.data.userId);

      // Subcoleção technicalSheets (fichas técnicas por cliente)
      match /technicalSheets/{sheetId} {
        allow read: if isAuth();
        allow write: if isAuth();
      }
    }

    // AGENDAMENTOS — equipe pode ver todos do studio, criar os seus
    match /appointments/{docId} {
      allow read: if isAuth() && (
        resource == null || isTeamMember(resource.data.userId)
      );
      // Criação: userId deve ser o ownerId efetivo
      allow create: if isAuth()
        && request.resource.data.userId == effectiveOwnerId();
      allow update, delete: if isAuth() && isTeamMember(resource.data.userId);
    }

    // FICHA TÉCNICA — equipe acessa, cada um cria a sua
    match /ficha_tecnica/{docId} {
      allow read: if isAuth() && (
        resource == null || isTeamMember(resource.data.userId)
      );
      // Criação: userId deve ser o ownerId efetivo
      allow create: if isAuth()
        && request.resource.data.userId == effectiveOwnerId();
      allow update, delete: if isAuth() && (
        isTeamMember(resource.data.userId)
      );
    }

    // PORTFÓLIO — equipe acessa
    match /portfolio/{docId} {
      allow read: if isAuth() && (
        resource == null || isTeamMember(resource.data.userId)
      );
      // Criação: userId deve ser o ownerId efetivo
      allow create: if isAuth()
        && request.resource.data.userId == effectiveOwnerId();
      allow update, delete: if isAuth() && isTeamMember(resource.data.userId);
    }

    // LEMBRETES — equipe acessa
    match /reminders/{docId} {
      allow read: if isAuth() && (
        resource == null || isTeamMember(resource.data.userId)
      );
      // Criação: userId deve ser o ownerId efetivo
      allow create: if isAuth()
        && request.resource.data.userId == effectiveOwnerId();
      allow update, delete: if isAuth() && isTeamMember(resource.data.userId);
    }

    // INTERAÇÕES/HISTÓRICO — equipe acessa
    match /interactions/{docId} {
      allow read: if isAuth() && (
        resource == null || isTeamMember(resource.data.userId)
      );
      // Criação: userId deve ser o ownerId efetivo
      allow create: if isAuth()
        && request.resource.data.userId == effectiveOwnerId();
      allow update, delete: if isAuth() && isTeamMember(resource.data.userId);
    }

    // TERMOS DE CONSENTIMENTO — equipe acessa + assinatura pública via token
    match /consents/{docId} {
      // Leitura: equipe autenticada OU público (para página de assinatura)
      allow read: if true;
      
      // Criação: apenas equipe autenticada com userId correto
      allow create: if isAuth()
        && request.resource.data.userId == effectiveOwnerId();
      
      // Update: equipe autenticada OU update público apenas de campos de assinatura
      allow update: if (isAuth() && isTeamMember(resource.data.userId))
        || request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['signature', 'signedAt', 'signedRemotely', 'status', 'updatedAt']);
      
      // Deleção: apenas equipe autenticada
      allow delete: if isAuth() && isTeamMember(resource.data.userId);
    }

    // ============================================================
    // DADOS EXCLUSIVOS DO OWNER (gestão)
    // Owner e profissionais vinculados ao studio
    // ============================================================

    // ESTOQUE — owner e equipe
    match /inventory/{docId} {
      allow read: if isAuth() && (
        resource == null || isTeamMember(resource.data.userId)
      );
      // Criação: userId deve ser o ownerId efetivo
      allow create: if isAuth()
        && request.resource.data.userId == effectiveOwnerId();
      allow update, delete: if isAuth() && isTeamMember(resource.data.userId);
    }

    // LOGS DE ESTOQUE — owner e equipe
    match /inventory_logs/{docId} {
      allow read: if isAuth() && (
        resource == null || isTeamMember(resource.data.userId)
      );
      // Criação: userId deve ser o ownerId efetivo
      allow create: if isAuth()
        && request.resource.data.userId == effectiveOwnerId();
      allow update, delete: if isAuth() && isTeamMember(resource.data.userId);
    }

    // AUDITORIA DE ESTOQUE — owner e equipe
    match /inventory_audits/{docId} {
      allow read: if isAuth() && (
        resource == null || isTeamMember(resource.data.userId)
      );
      // Criação: userId deve ser o ownerId efetivo
      allow create: if isAuth()
        && request.resource.data.userId == effectiveOwnerId();
      allow update, delete: if isAuth() && isTeamMember(resource.data.userId);
    }

    // FINANCEIRO — só owner
    match /invoices/{docId} {
      allow read: if isAuth() && (
        resource == null || isTeamMember(resource.data.userId)
      );
      // Criação: só owner direto (não profissional)
      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuth() && isOwner(resource.data.userId);
    }

    // CONTAS A PAGAR — só owner
    match /expenses/{docId} {
      allow read: if isAuth() && (
        resource == null || isOwner(resource.data.userId)
      );
      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuth() && isOwner(resource.data.userId);
    }

    // LISTA DE COMPRAS — só owner
    match /shoppingList/{docId} {
      allow read: if isAuth() && (
        resource == null || isOwner(resource.data.userId)
      );
      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuth() && isOwner(resource.data.userId);
    }

    // CATÁLOGO — leitura pela equipe, escrita só owner
    match /catalog/{docId} {
      allow read: if isAuth() && (
        resource == null || isTeamMember(resource.data.userId)
      );
      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuth() && isOwner(resource.data.userId);
    }

    // ANÁLISES DE CUSTO — só owner
    match /cost_analyses/{docId} {
      allow read: if isAuth() && (
        resource == null || isOwner(resource.data.userId)
      );
      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuth() && isOwner(resource.data.userId);
    }

    // ============================================================
    // PROGRAMA DE INDICAÇÕES
    // ============================================================
    match /referrals/{docId} {
      // Cada usuário só lê seus próprios referrals
      allow read: if isAuth() && (
        resource == null ||
        resource.data.referrerId == request.auth.uid ||
        resource.data.userId == request.auth.uid
      );
      allow write: if false;
    }
    match /referral_payments/{docId} {
      // Leitura: próprio indicador OU admin (sem auth, protegido por PIN na UI)
      allow read: if true;
      // Criação: usuários autenticados (ao se cadastrar via link de indicação)
      allow create: if isAuth();
      // Atualização: admin marca como pago (protegido por PIN na UI)
      allow update: if true;
      allow delete: if false;
    }

    // ============================================================
    // STUDIOS — Perfil do studio (nova coleção centralizada)
    // ============================================================
    match /studios/{studioId} {
      // Leitura pública: necessário para mini-site de agendamento buscar por slug
      allow read: if true;
      // Escrita apenas pelo próprio owner
      allow write: if isOwner(studioId);

      // Subcoleção bookings — escrita pública (clientes sem auth), leitura só do owner
      match /bookings/{bookingId} {
        allow read: if isOwner(studioId) || isProfessionalOf(studioId);
        allow create: if true;  // qualquer cliente pode criar agendamento
        // Update: owner pode tudo, Cloud Function pode atualizar paymentStatus
        allow update: if isOwner(studioId)
          || request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['paymentStatus', 'paymentId', 'paymentUrl', 'paidAt', 'refundedAt', 'status']);
        allow delete: if isOwner(studioId);
      }

      // Subcoleção services — leitura pública, escrita só owner
      match /services/{serviceId} {
        allow read: if true;
        allow write: if isOwner(studioId);
      }

      // Subcoleção bolsa_beleza
      match /bolsa_beleza/{docId} {
        allow read, write: if isOwner(studioId);
      }
    }

    // ============================================================
    // CONFIGURAÇÕES DO ESTÚDIO
    // Leitura pública para booking verificar config de pagamento
    // Escrita apenas pelo owner
    // ============================================================
    match /studioConfig/{studioId} {
      allow read: if true;
      allow write: if isOwner(studioId);
    }

    // ============================================================
    // TRANSAÇÕES DE RECARGA DE SMS
    // ============================================================
    match /sms_transactions/{docId} {
      allow read: if isAuth() && (
        resource == null || isTeamMember(resource.data.studioId)
      );
      allow write: if false; // Gerenciado estritamente via Cloud Functions
    }

    // ============================================================
    // AVALIAÇÕES (REVIEWS) — escrita pública, leitura só do owner
    // ============================================================
    match /reviews/{reviewId} {
      // Qualquer pessoa pode criar (link enviado por WhatsApp, sem auth)
      // Validar que studioId está presente e é uma string
      allow create: if request.resource.data.studioId is string
        && request.resource.data.studioId.size() > 0
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      // Owner pode ler as suas avaliações
      allow read: if isAuth() && (
        resource == null || resource.data.studioId == request.auth.uid
      );
      // Não pode editar ou excluir
      allow update, delete: if false;
    }

    // ============================================================
    // CONVITES DE PARCEIROS — leitura pública, escrita controlada
    // ============================================================
    match /invites/{inviteId} {
      allow read: if true;   // app valida convite sem auth
      // Criação: apenas autenticados
      allow create: if isAuth();
      // Atualização: apenas campos de uso (usedBy, usedAt, status)
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['usedBy', 'usedAt', 'status', 'usedCount']);
      allow delete: if false;
    }

    // ============================================================
    // QUESTIONÁRIO DE AVALIAÇÃO — escrita pública, leitura apenas admin
    // ============================================================
    match /survey_responses/{responseId} {
      // Qualquer pessoa pode criar (formulário público sem auth)
      allow create: if true;
      // Ninguém pode ler, editar ou excluir via client
      allow read, update, delete: if false;
    }

    // ============================================================
    // CRM ADMINISTRATIVO E CAMPANHAS EM LOTE
    // ============================================================
    match /admin_contacts/{contactId} {
      allow read, write: if true;
    }
    match /admin_campaigns/{campaignId} {
      allow read, write: if true;
    }

  }
}