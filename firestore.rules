rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // === companies ===
    // Usuário autenticado pode ler qualquer empresa (necessário para o sistema de indicações
    // buscar dados do indicador). Só pode escrever no próprio documento.
    match /companies/{companyId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == companyId;
    }

    // === referral_payments ===
    // Qualquer usuário autenticado pode ler (para visualizar status do próprio bônus).
    // Somente o admin (via painel) pode escrever — verificado pelo email.
    match /referral_payments/{paymentId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.email in [
          'negocioscota@gmail.com',
          'admin@clientehubclin.app.br'
        ];
    }

    // === clients ===
    match /clients/{clientId} {
      allow read, write: if request.auth != null;
    }

    // === appointments ===
    match /appointments/{appointmentId} {
      allow read, write: if request.auth != null;
    }

    // === interactions ===
    match /interactions/{interactionId} {
      allow read, write: if request.auth != null;
    }

    // === inventory ===
    match /inventory/{itemId} {
      allow read, write: if request.auth != null;
    }

    // === inventory_logs ===
    match /inventory_logs/{logId} {
      allow read, write: if request.auth != null;
    }

    // === invoices ===
    match /invoices/{invoiceId} {
      allow read, write: if request.auth != null;
    }

    // === services ===
    match /services/{serviceId} {
      allow read, write: if request.auth != null;
    }

    // === portfolio ===
    match /portfolio/{itemId} {
      allow read, write: if request.auth != null;
    }

    // === team ===
    match /team/{memberId} {
      allow read, write: if request.auth != null;
    }

    // === technical_records (fichas técnicas) ===
    match /technical_records/{recordId} {
      allow read, write: if request.auth != null;
    }

    // === consents (termos de consentimento) ===
    match /consents/{consentId} {
      allow read, write: if request.auth != null;
    }

    // === reviews ===
    match /reviews/{reviewId} {
      allow read, write: if request.auth != null;
    }

    // === reminders ===
    match /reminders/{reminderId} {
      allow read, write: if request.auth != null;
    }

    // === orders (pedidos de pagamento) ===
    match /orders/{orderId} {
      allow read, write: if request.auth != null;
    }

    // Bloqueia tudo o que não foi explicitamente permitido
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
