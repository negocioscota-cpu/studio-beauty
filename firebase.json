{
  "firestore": {
    "database": "(default)",
    "location": "us-east1",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs20"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/booking/**",
        "destination": "/booking.html"
      },
      {
        "source": "/portfolio/**",
        "destination": "/portfolio.html"
      },
      {
        "source": "/bio/**",
        "destination": "/bio.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "auth": {
    "providers": {
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "LashBrow",
        "supportEmail": "negocioscota@gmail.com"
      }
    }
  }
}
